<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  LM Studio läuft im lokalen Netz über HTTP. NSAllowsLocalNetworking
	  erlaubt genau das — und nur das. ATS bleibt für alles Übrige scharf;
	  NSAllowsArbitraryLoads wäre der Holzhammer und würde auch die
	  Verbindungen zu Anthropic und OpenAI ungeschützt lassen.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
