    "Apple Intelligence ist in den Systemeinstellungen ausgeschaltet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist in den Systemeinstellungen ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is switched off in System Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivato nelle impostazioni."
          }
        },
        "es": {
          "stringUnit": {
