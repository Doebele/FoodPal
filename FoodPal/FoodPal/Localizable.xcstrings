    "Sechs Schichten von unten: gezuckerte Kondensmilch, Licor 43, Espresso über den Löffelrücken, Milchschaum, Zimt, Zitronenschale. Gerührt wird erst am Tisch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Schichten von unten: gezuckerte Kondensmilch, Licor 43, Espresso über den Löffelrücken, Milchschaum, Zimt, Zitronenschale. Gerührt wird erst am Tisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six layers from the bottom: sweetened condensed milk, Licor 43, espresso over the back of a spoon, milk foam, cinnamon, lemon zest. It is stirred only at the table."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis capas desde abajo: leche condensada azucarada, Licor 43, espresso sobre el dorso de una cuchara, espuma de leche, canela, piel de limón. Se remueve sólo en la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six couches en partant du bas : lait concentré sucré, Licor 43, expresso sur le dos d’une cuillère, mousse de lait, cannelle, zeste de citron. On ne mélange qu’à table."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei strati dal basso: latte condensato zuccherato, Licor 43, espresso sul dorso del cucchiaio, schiuma di latte, cannella, scorza di limone. Si mescola solo a tavola."
          }
        }
      }
    },
    "Sichern": {
      "extractionState": "manual",
