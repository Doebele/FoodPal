    "Umgekehrte Reihenfolge: der Espresso kommt in die Milch, nicht die Milch in den Espresso. Daher die drei Schichten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgekehrte Reihenfolge: der Espresso kommt in die Milch, nicht die Milch in den Espresso. Daher die drei Schichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The order is reversed: the espresso goes into the milk, not the milk into the espresso. Hence the three layers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordre est inversé : l’expresso va dans le lait, et non le lait dans l’expresso. D’où les trois couches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordine invertito: l’espresso va nel latte, non il latte nell’espresso. Da qui i tre strati."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orden se invierte: el espresso va en la leche, no la leche en el espresso. De ahí las tres capas."
          }
        }
      }
    },
