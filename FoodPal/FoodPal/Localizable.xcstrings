    "Skandinavien, 2000er-Jahre, dem schwedischen Röster Koppi zugeschrieben. Die Bitterkeit des Chinins und die Säure des Kaffees ziehen in dieselbe Richtung.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skandinavien, 2000er-Jahre, dem schwedischen Röster Koppi zugeschrieben. Die Bitterkeit des Chinins und die Säure des Kaffees ziehen in dieselbe Richtung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scandinavia, the 2000s, credited to the Swedish roaster Koppi. The bitterness of the quinine and the acidity of the coffee pull in the same direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escandinavia, años dos mil, atribuido al tostador sueco Koppi. El amargor de la quinina y la acidez del café tiran en la misma dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scandinavie, années 2000, attribué au torréfacteur suédois Koppi. L’amertume de la quinine et l’acidité du café tirent dans le même sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scandinavia, anni Duemila, attribuito al torrefattore svedese Koppi. L’amaro del chinino e l’acidità del caffè tirano nella stessa direzione."
          }
        }
      }
    },
    "So viel Koffein steckt in rund zwanzig Espressi.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So viel Koffein steckt in rund zwanzig Espressi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That much caffeine sits in about twenty espressos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanta cafeína hay en unos veinte espressos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autant de caféine, c’est environ vingt expressos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanta caffeina sta in una ventina di espressi."
          }
        }
      }
    },
    "So viel passt in eine Mahlzeit nur, wenn beim Tippen eine Stelle verrutscht ist.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So viel passt in eine Mahlzeit nur, wenn beim Tippen eine Stelle verrutscht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That much fits into one meal only if a digit slipped while typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto cabe en una comida sólo si al teclear se ha corrido un dígito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autant ne tient dans un repas que si un chiffre a glissé à la saisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto sta in un pasto solo se digitando è scivolata una cifra."
          }
        }
      }
    },
    "Spanien, oft dem Baskenland oder Katalonien zugeschrieben; auch in Portugal und Lateinamerika zu Hause. Serviert im kleinen Glas, 60 bis 70 ml.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spanien, oft dem Baskenland oder Katalonien zugeschrieben; auch in Portugal und Lateinamerika zu Hause. Serviert im kleinen Glas, 60 bis 70 ml."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spain, often credited to the Basque Country or Catalonia; at home in Portugal and Latin America too. Served in a small glass, 60 to 70 ml."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "España, a menudo atribuido al País Vasco o a Cataluña; también está en casa en Portugal y Latinoamérica. Se sirve en vaso pequeño, de 60 a 70 ml."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espagne, souvent attribué au Pays basque ou à la Catalogne ; également chez lui au Portugal et en Amérique latine. Servi dans un petit verre, 60 à 70 ml."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spagna, spesso attribuito ai Paesi Baschi o alla Catalogna; di casa anche in Portogallo e in America Latina. Servito nel bicchierino, 60-70 ml."
          }
        }
      }
    },
