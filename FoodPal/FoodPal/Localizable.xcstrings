    "Diktieren über das Mikrofon der Tastatur. Zeitangaben wie „gestern Abend um neun“ werden übernommen; mehrere Gerichte werden einzeln erfasst.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren über das Mikrofon der Tastatur. Zeitangaben wie „gestern Abend um neun“ werden übernommen; mehrere Gerichte werden einzeln erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate with the keyboard’s microphone. Times such as “yesterday at nine” are picked up; several dishes are logged separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicta con el micrófono del teclado. Horas como «ayer a las nueve» se recogen; varios platos se registran por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictez avec le microphone du clavier. Les heures comme « hier à neuf heures » sont reprises ; plusieurs plats sont enregistrés séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta con il microfono della tastiera. Orari come “ieri alle nove” vengono ripresi; più piatti vengono registrati separatamente."
          }
        }
      }
    },
    "Doppelt so viel Wasser durch dasselbe Pulver. Länger heisst mehr Koffein und mehr Bitterstoffe.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelt so viel Wasser durch dasselbe Pulver. Länger heisst mehr Koffein und mehr Bitterstoffe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twice the water through the same grounds. Longer means more caffeine and more bitterness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El doble de agua a través del mismo molido. Más largo significa más cafeína y más amargor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux fois plus d’eau à travers la même mouture. Plus long veut dire plus de caféine et plus d’amertume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il doppio dell’acqua attraverso la stessa dose. Più lungo significa più caffeina e più amaro."
          }
        }
      }
    },
    "Doppelter Espresso, mit Eis im Shaker kalt geschüttelt und über frisches Eis abgegossen. Das Schütteln kühlt ihn und macht ihn cremig.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelter Espresso, mit Eis im Shaker kalt geschüttelt und über frisches Eis abgegossen. Das Schütteln kühlt ihn und macht ihn cremig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A double espresso shaken cold with ice and poured over fresh ice. The shaking chills it and makes it creamy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espresso doble agitado en frío con hielo y vertido sobre hielo nuevo. El agitado lo enfría y lo vuelve cremoso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un double expresso secoué à froid avec de la glace et versé sur de la glace fraîche. Le shaker le refroidit et le rend crémeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doppio espresso agitato a freddo con ghiaccio e versato su ghiaccio fresco. Agitare lo raffredda e lo rende cremoso."
          }
        }
      }
    },
    "Doppelter Ristretto mit feinporigem Mikroschaum, flach eingegossen. Stärker als der Cappuccino und ohne Schaumhaube.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelter Ristretto mit feinporigem Mikroschaum, flach eingegossen. Stärker als der Cappuccino und ohne Schaumhaube."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A double ristretto with fine microfoam, poured flat. Stronger than a cappuccino and without the foam dome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ristretto doble con microespuma fina, vertida plana. Más fuerte que el capuchino y sin cúpula de espuma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un double ristretto avec une micromousse fine, versée à plat. Plus corsé qu’un cappuccino et sans dôme de mousse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doppio ristretto con microschiuma fine, versata piatta. Più forte del cappuccino e senza cupola di schiuma."
          }
        }
      }
    },
    "Drei Würfelzucker ins Glas, Kaffee darüber, bis man sie nicht mehr sieht — dann Träsch, bis man sie wieder sieht.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Würfelzucker ins Glas, Kaffee darüber, bis man sie nicht mehr sieht — dann Träsch, bis man sie wieder sieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three sugar cubes in the glass, coffee over them until they disappear — then fruit brandy until they show again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres terrones en el vaso, café hasta que desaparezcan — luego aguardiente hasta que vuelvan a verse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois morceaux de sucre dans le verre, du café jusqu’à ce qu’ils disparaissent — puis de l’eau-de-vie jusqu’à ce qu’ils réapparaissent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre zollette nel bicchiere, caffè finché non si vedono più — poi acquavite finché non riappaiono."
          }
        }
      }
    },
    "Dresden, 1908. Melitta Bentz legte ein Löschblatt in einen durchlöcherten Messingtopf und meldete es zum Patent an.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dresden, 1908. Melitta Bentz legte ein Löschblatt in einen durchlöcherten Messingtopf und meldete es zum Patent an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dresden, 1908. Melitta Bentz put a sheet of blotting paper into a perforated brass pot and filed it for patent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dresde, 1908. Melitta Bentz puso una hoja de papel secante en un recipiente de latón perforado y lo patentó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dresde, 1908. Melitta Bentz a placé un buvard dans un pot en laiton percé et l’a fait breveter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dresda, 1908. Melitta Bentz mise un foglio di carta assorbente in un vaso di ottone forato e lo brevettò."
          }
        }
      }
    },
    "Dunkel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
