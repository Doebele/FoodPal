    "Kuba unter spanischer Herrschaft: die Truppe mischte Rum in den Kaffee, für den Mut — spanisch coraje. Aus corajillo wurde carajillo.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuba unter spanischer Herrschaft: die Truppe mischte Rum in den Kaffee, für den Mut — spanisch coraje. Aus corajillo wurde carajillo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba under Spanish rule: the troops mixed rum into their coffee for courage — coraje in Spanish. Corajillo became carajillo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba bajo dominio español: la tropa mezclaba ron en el café para darse coraje. De corajillo salió carajillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba sous domination espagnole : la troupe mêlait du rhum au café pour le courage — coraje en espagnol. De corajillo est venu carajillo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba sotto dominio spagnolo: la truppa mescolava rum nel caffè per il coraggio — coraje in spagnolo. Da corajillo è venuto carajillo."
          }
        }
      }
    },
