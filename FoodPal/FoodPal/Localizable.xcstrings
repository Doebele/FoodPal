          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Francese"
          }
        }
      }
    },
    "Freddo Espresso, darauf kalt geschäumte Milch — auf Griechisch afrogala. Sie darf nicht warm werden, sonst fällt sie zusammen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freddo Espresso, darauf kalt geschäumte Milch — auf Griechisch afrogala. Sie darf nicht warm werden, sonst fällt sie zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A freddo espresso topped with cold-frothed milk — afrogala in Greek. It must not warm up, or it collapses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un freddo espresso coronado con leche espumada en frío — afrogala en griego. No debe calentarse, o se desmorona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un freddo espresso coiffé de lait moussé à froid — afrogala en grec. Il ne doit pas se réchauffer, sinon il retombe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un freddo espresso con sopra latte montato a freddo — in greco afrogala. Non deve scaldarsi, altrimenti si affloscia."
          }
        }
      }
    },
    "Für Kaffee auf mg wechseln": {
