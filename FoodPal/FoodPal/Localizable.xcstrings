    "Australien oder Neuseeland, 1980er-Jahre — welches von beiden, streiten beide bis heute.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Australien oder Neuseeland, 1980er-Jahre — welches von beiden, streiten beide bis heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Australia or New Zealand, in the 1980s — which of the two is still disputed by both."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Australia o Nueva Zelanda, años ochenta: cuál de las dos, aún se lo disputan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Australie ou Nouvelle-Zélande, années 1980 — laquelle des deux, elles s’en disputent encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Australia o Nuova Zelanda, anni Ottanta — quale delle due, se lo contendono ancora."
          }
        }
      }
    },
