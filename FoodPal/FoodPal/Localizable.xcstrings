    "Je ein Drittel Espresso, warme Milch und Schaum.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ein Drittel Espresso, warme Milch und Schaum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One third each: espresso, warm milk, foam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tercio de espresso, un tercio de leche caliente y un tercio de espuma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tiers d’expresso, un tiers de lait chaud, un tiers de mousse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
