    "Benannt nach Mokka, dem jemenitischen Hafen, über den Kaffee jahrhundertelang nach Europa kam.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benannt nach Mokka, dem jemenitischen Hafen, über den Kaffee jahrhundertelang nach Europa kam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Named after Mocha, the Yemeni port through which coffee reached Europe for centuries."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommé d’après Moka, le port yéménite par lequel le café est arrivé en Europe pendant des siècles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prende il nome da Mokha, il porto yemenita attraverso cui il caffè arrivò in Europa per secoli."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debe su nombre a Moca, el puerto yemení por el que el café llegó a Europa durante siglos."
          }
        }
      }
    },
