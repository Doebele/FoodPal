    "Heisses Wasser läuft ohne Druck durch grob gemahlenes Pulver. Keine Crema, dafür klarer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heisses Wasser läuft ohne Druck durch grob gemahlenes Pulver. Keine Crema, dafür klarer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hot water runs through coarsely ground coffee without pressure. No crema, but a clearer cup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agua caliente pasa sin presión por un molido grueso. Sin crema, pero más limpio en boca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eau chaude traverse une mouture grossière sans pression. Pas de crema, mais une tasse plus nette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acqua calda attraversa una macinatura grossa senza pressione. Niente crema, ma più pulito nel gusto."
          }
        }
      }
    },
