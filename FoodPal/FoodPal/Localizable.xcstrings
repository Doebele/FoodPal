          }
        }
      }
    },
    "Dasselbe Pulver, halb so viel Wasser. Dichter im Geschmack und weniger Koffein als der Espresso — die Extraktion bricht früher ab.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Pulver, halb so viel Wasser. Dichter im Geschmack und weniger Koffein als der Espresso — die Extraktion bricht früher ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same grounds, half the water. Denser in taste and less caffeine than an espresso — extraction stops earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo molido, la mitad de agua. Más denso y con menos cafeína que un espresso: la extracción se detiene antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même mouture, deux fois moins d’eau. Plus dense en bouche et moins caféiné qu’un expresso — l’extraction s’arrête plus tôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stessa dose, metà acqua. Più denso e con meno caffeina dell’espresso: l’estrazione si ferma prima."
          }
        }
      }
    },
    "Der Eintrag wird auch aus Apple Health entfernt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag wird auch aus Apple Health entfernt."
