    "Kaffee und heisse Milch zu gleichen Teilen. Wer sie heller mag, bestellt eine Schale Gold — benannt nach der Farbe, nicht nach der Menge.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaffee und heisse Milch zu gleichen Teilen. Wer sie heller mag, bestellt eine Schale Gold — benannt nach der Farbe, nicht nach der Menge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coffee and hot milk in equal parts. If you like it paler, you order a Schale Gold — named after the colour, not the quantity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Café y leche caliente a partes iguales. Quien la prefiere más clara pide una «Schale Gold» — por el color, no por la cantidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Café et lait chaud à parts égales. Qui la préfère plus claire commande une « Schale Gold » — nommée d’après la couleur, pas la quantité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffè e latte caldo in parti uguali. Chi la preferisce più chiara ordina una «Schale Gold» — dal colore, non dalla quantità."
          }
        }
      }
    },
