    "Teneriffa, benannt nach einem Stammgast: Sebastián, genannt „el Barraco“, bestellte ihn immer genau so.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teneriffa, benannt nach einem Stammgast: Sebastián, genannt „el Barraco“, bestellte ihn immer genau so."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenerife, named after a regular: Sebastián, called “el Barraco”, always ordered it exactly like this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenerife, por el nombre de un cliente habitual: Sebastián, «el Barraco», lo pedía siempre exactamente así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenerife, du nom d’un habitué : Sebastián, dit « el Barraco », le commandait toujours exactement ainsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenerife, dal nome di un cliente abituale: Sebastián, detto «el Barraco», lo ordinava sempre proprio così."
          }
        }
      }
    },
    "Thessaloniki, Messe 1957: ein Nestlé-Mitarbeiter fand kein heisses Wasser, griff zum Shaker vom Nachbarstand und schüttelte seinen Nescafé kalt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thessaloniki, Messe 1957: ein Nestlé-Mitarbeiter fand kein heisses Wasser, griff zum Shaker vom Nachbarstand und schüttelte seinen Nescafé kalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thessaloniki, trade fair 1957: a Nestlé employee found no hot water, grabbed the shaker from the neighbouring stand and shook his Nescafé cold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salónica, feria de 1957: un empleado de Nestlé no encontró agua caliente, cogió la coctelera del estand vecino y agitó su Nescafé en frío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thessalonique, foire de 1957 : un employé de Nestlé, faute d’eau chaude, a pris le shaker du stand voisin et secoué son Nescafé à froid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salonicco, fiera del 1957: un dipendente Nestlé non trovò acqua calda, prese lo shaker dello stand accanto e agitò il suo Nescafé a freddo."
          }
        }
      }
    },
    "Tonic Water": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonic Water"
          }
        },
