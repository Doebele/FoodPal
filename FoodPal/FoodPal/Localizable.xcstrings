    "Auf die Rosette tippen, um zu diktieren. Zeitangaben wie „gestern Abend um neun“ werden übernommen; mehrere Gerichte werden einzeln erfasst.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Rosette tippen, um zu diktieren. Zeitangaben wie „gestern Abend um neun“ werden übernommen; mehrere Gerichte werden einzeln erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the rosette to dictate. Times such as “yesterday at nine” are picked up; several dishes are logged separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la roseta para dictar. Horas como «ayer a las nueve» se recogen; varios platos se registran por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la rosace pour dicter. Les heures comme « hier à neuf heures » sont reprises ; plusieurs plats sont enregistrés séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la rosetta per dettare. Orari come “ieri alle nove” vengono ripresi; più piatti vengono registrati separatamente."
          }
        }
      }
    },
