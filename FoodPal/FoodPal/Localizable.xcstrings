    "Foynes, Irland, 1943. Der Küchenchef Joe Sheridan wärmte damit gestrandete Flugpassagiere auf; auf die Frage, ob das brasilianischer Kaffee sei, soll er geantwortet haben, es sei irischer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foynes, Irland, 1943. Der Küchenchef Joe Sheridan wärmte damit gestrandete Flugpassagiere auf; auf die Frage, ob das brasilianischer Kaffee sei, soll er geantwortet haben, es sei irischer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foynes, Ireland, 1943. The chef Joe Sheridan warmed up stranded air passengers with it; asked whether it was Brazilian coffee, he is said to have replied that it was Irish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Foynes, Irlanda, 1943. El cocinero Joe Sheridan calentaba con él a los pasajeros varados; a quien preguntó si era café brasileño, se dice que respondió que era irlandés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Foynes, Irlande, 1943. Le chef Joe Sheridan en réchauffait des passagers aériens bloqués ; à qui lui demandait si c’était du café brésilien, il aurait répondu que c’était de l’irlandais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foynes, Irlanda, 1943. Lo chef Joe Sheridan ci scaldava i passeggeri rimasti a terra; a chi chiedeva se fosse caffè brasiliano, avrebbe risposto che era irlandese."
          }
        }
      }
    },
    "Frankreich, zum Frühstück, in der Schale ohne Henkel — gross genug, um das Croissant hineinzutauchen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankreich, zum Frühstück, in der Schale ohne Henkel — gross genug, um das Croissant hineinzutauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "France, at breakfast, in a bowl without a handle — big enough to dip the croissant in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Francia, en el desayuno, en un tazón sin asa — lo bastante grande para mojar el cruasán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "France, au petit-déjeuner, dans un bol sans anse — assez grand pour y tremper le croissant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Francia, a colazione, nella scodella senza manico — abbastanza grande da inzuppare il croissant."
          }
        }
      }
    },
    "Französisch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Französisch"
          }
        },
