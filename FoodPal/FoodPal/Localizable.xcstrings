    "Zucker im heissen Kaffee auflösen, Whiskey dazu, halbsteifen Rahm über den Löffelrücken aufschwimmen lassen. Getrunken wird durch den Rahm hindurch, nicht gerührt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zucker im heissen Kaffee auflösen, Whiskey dazu, halbsteifen Rahm über den Löffelrücken aufschwimmen lassen. Getrunken wird durch den Rahm hindurch, nicht gerührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissolve sugar in the hot coffee, add whiskey, float half-whipped cream over the back of a spoon. You drink through the cream; you do not stir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disolver el azúcar en el café caliente, añadir el whiskey, hacer flotar nata semimontada sobre el dorso de una cuchara. Se bebe a través de la nata; no se remueve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissoudre le sucre dans le café chaud, ajouter le whiskey, faire flotter une crème à demi fouettée sur le dos d’une cuillère. On boit à travers la crème, on ne remue pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sciogliere lo zucchero nel caffè caldo, aggiungere il whiskey, far galleggiare panna semimontata sul dorso del cucchiaio. Si beve attraverso la panna, non si mescola."
          }
        }
      }
    },
    "Zucker ins vorgewärmte Stielglas, Pflümli darüber, mit Kaffee auffüllen bis einen Finger unter den Rand, Schlagrahm obenauf.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zucker ins vorgewärmte Stielglas, Pflümli darüber, mit Kaffee auffüllen bis einen Finger unter den Rand, Schlagrahm obenauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugar into the warmed stemmed glass, plum brandy over it, fill with coffee to a finger below the rim, whipped cream on top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Azúcar en la copa precalentada, aguardiente de ciruela encima, café hasta un dedo del borde, nata montada arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sucre dans le verre à pied préchauffé, l’eau-de-vie de prune par-dessus, remplir de café jusqu’à un doigt du bord, crème fouettée dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zucchero nel bicchiere a stelo preriscaldato, acquavite di prugne sopra, caffè fino a un dito dal bordo, panna montata in cima."
          }
        }
      }
    },
    "Zugriff auf Mikrofon oder Spracherkennung fehlt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Mikrofon oder Spracherkennung fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone or speech recognition access is missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el acceso al micrófono o al reconocimiento de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au micro ou à la reconnaissance vocale manque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca l’accesso al microfono o al riconoscimento vocale."
          }
        }
      }
    },
