    "25 ml in 25 Sekunden unter neun bar durch fein gemahlenes Pulver. Die Crema kommt vom Druck, nicht von der Röstung.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "25 ml in 25 Sekunden unter neun bar durch fein gemahlenes Pulver. Die Crema kommt vom Druck, nicht von der Röstung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "25 ml in 25 seconds at nine bar through finely ground coffee. The crema comes from the pressure, not from the roast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "25 ml en 25 secondes à neuf bars à travers une mouture fine. La crema vient de la pression, pas de la torréfaction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "25 ml in 25 secondi a nove bar attraverso una macinatura fine. La crema viene dalla pressione, non dalla tostatura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "25 ml en 25 segundos a nueve bares a través de un molido fino. La crema viene de la presión, no del tueste."
          }
        }
      }
    },
