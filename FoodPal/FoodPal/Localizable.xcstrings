    "Geschmolzene Schokolade im kleinen Glas verstrichen, Espresso darauf, Milchschaum darüber, Kakao obenauf.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschmolzene Schokolade im kleinen Glas verstrichen, Espresso darauf, Milchschaum darüber, Kakao obenauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Melted chocolate smeared inside a small glass, espresso onto it, milk foam over that, cocoa on top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chocolate fundido untado en el vaso pequeño, el espresso encima, la espuma de leche después, el cacao al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du chocolat fondu étalé dans un petit verre, l’expresso par-dessus, la mousse de lait ensuite, le cacao pour finir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cioccolato fuso spalmato nel bicchierino, l’espresso sopra, la schiuma di latte ancora sopra, il cacao a finire."
          }
        }
      }
    },
