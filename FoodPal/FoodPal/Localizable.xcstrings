    "Filterkaffee und heisse Milch zu gleichen Teilen, beides zugleich in die Schale gegossen. Kein Schaum, keine Haube.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterkaffee und heisse Milch zu gleichen Teilen, beides zugleich in die Schale gegossen. Kein Schaum, keine Haube."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter coffee and hot milk in equal parts, both poured into the bowl at once. No foam, no cap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Café de filtro y leche caliente a partes iguales, vertidos a la vez en el tazón. Sin espuma, sin capa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Café filtre et lait chaud à parts égales, versés ensemble dans le bol. Pas de mousse, pas de chapeau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffè filtro e latte caldo in parti uguali, versati insieme nella scodella. Niente schiuma, niente cappello."
          }
        }
      }
    },
