    "Gestern Abend um neun eine kleine Ramensuppe mit Frühlingszwiebel, dazu drei Scheiben Baguette dünn mit Butter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestern Abend um neun eine kleine Ramensuppe mit Frühlingszwiebel, dazu drei Scheiben Baguette dünn mit Butter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday at nine a small bowl of ramen with spring onion, and three thin slices of baguette with butter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayer a las nueve un cuenco pequeño de ramen con cebolleta y tres rebanadas finas de baguette con mantequilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier à neuf heures un petit bol de ramen à l’oignon nouveau, et trois fines tranches de baguette beurrées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieri alle nove una piccola zuppa di ramen con cipollotto e tre fette sottili di baguette con burro"
          }
        }
      }
    },
    "Gezuckerte Kondensmilch ins Glas, Espresso vorsichtig darüber. Gleiche Teile, zwei Schichten — man sieht die Grenze.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezuckerte Kondensmilch ins Glas, Espresso vorsichtig darüber. Gleiche Teile, zwei Schichten — man sieht die Grenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweetened condensed milk into the glass, espresso carefully over it. Equal parts, two layers — you can see the line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leche condensada azucarada en el vaso, el espresso con cuidado encima. A partes iguales, dos capas — la línea se ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lait concentré sucré dans le verre, l’expresso versé doucement dessus. À parts égales, deux couches — la limite se voit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Latte condensato zuccherato nel bicchiere, espresso versato con cura sopra. Parti uguali, due strati — il confine si vede."
          }
        }
      }
    },
    "Griechenland, frühe 1990er. Anders als der Frappé aus echtem Espresso — das ist der ganze Unterschied und der ganze Streit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Griechenland, frühe 1990er. Anders als der Frappé aus echtem Espresso — das ist der ganze Unterschied und der ganze Streit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greece, early 1990s. Unlike the frappé, made from real espresso — that is the whole difference and the whole argument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grecia, principios de los noventa. A diferencia del frappé, con espresso de verdad — ahí está toda la diferencia y toda la discusión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grèce, début des années 1990. Contrairement au frappé, à base de vrai expresso — c’est toute la différence et toute la querelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grecia, primi anni Novanta. A differenza del frappé, con vero espresso — è tutta la differenza e tutta la disputa."
          }
        }
      }
    },
    "Griechenland, und heute das meistgetrunkene kalte Kaffeegetränk des Landes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Griechenland, und heute das meistgetrunkene kalte Kaffeegetränk des Landes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greece, and today the country’s most-drunk cold coffee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grecia, y hoy el café frío más bebido del país."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grèce, et aujourd’hui le café froid le plus bu du pays."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grecia, e oggi il caffè freddo più bevuto del paese."
          }
        }
      }
    },
