          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottoman, since the 16th century. The preparation has been on the Unesco list of intangible cultural heritage since 2013."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomano, desde el siglo XVI. La preparación está desde 2013 en la lista de la Unesco del patrimonio cultural inmaterial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottoman, depuis le XVIe siècle. La préparation figure depuis 2013 sur la liste du patrimoine culturel immatériel de l’Unesco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottomano, dal Cinquecento. La preparazione è dal 2013 nella lista Unesco del patrimonio culturale immateriale."
          }
        }
      }
    },
