    "Zwei Espressi aus einem Sieb, in einer Tasse: doppeltes Pulver, doppelte Menge.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Espressi aus einem Sieb, in einer Tasse: doppeltes Pulver, doppelte Menge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two espressos from one basket, in one cup: double the grounds, double the volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos espressos de un solo filtro, en una taza: doble molido, doble volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux expressos dans un seul filtre, une seule tasse : double mouture, double volume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due espressi da un solo filtro, in una tazza: doppia dose, doppio volume."
          }
        }
      }
    },
    "Zwei Linien: der langsame Tropfturm aus Kyoto und der Kaltauszug aus New Orleans, dort mit Zichorie.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Linien: der langsame Tropfturm aus Kyoto und der Kaltauszug aus New Orleans, dort mit Zichorie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two lines: the slow drip tower from Kyoto and the cold steep from New Orleans, there with chicory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos líneas: la torre de goteo lento de Kioto y la infusión fría de Nueva Orleans, allí con achicoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux lignées : la tour à goutte lente de Kyoto et l’infusion froide de La Nouvelle-Orléans, là-bas avec de la chicorée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due filoni: la torre a goccia lenta di Kyoto e l’infusione fredda di New Orleans, lì con la cicoria."
          }
        }
      }
    },
    "Zwei Tagesbedarfe auf einem Teller — ist da eine Null zu viel?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Tagesbedarfe auf einem Teller — ist da eine Null zu viel?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two daily requirements on one plate — is there a zero too many?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos necesidades diarias en un plato — ¿sobra un cero?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux besoins journaliers dans une seule assiette — un zéro de trop ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due fabbisogni giornalieri in un piatto — c’è uno zero di troppo?"
          }
        }
      }
    },
    "Zwölf bis zwanzig Stunden kalt gezogen statt heiss gebrüht. Wenig Säure, viel Koffein.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwölf bis zwanzig Stunden kalt gezogen statt heiss gebrüht. Wenig Säure, viel Koffein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steeped cold for twelve to twenty hours instead of brewed hot. Low acidity, high caffeine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En infusión fría de doce a veinte horas en lugar de extracción caliente. Poca acidez, mucha cafeína."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infusé à froid pendant douze à vingt heures au lieu d’être passé à chaud. Peu d’acidité, beaucoup de caféine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In infusione a freddo per dodici-venti ore invece che in estrazione calda. Poca acidità, molta caffeina."
          }
        }
      }
    },
