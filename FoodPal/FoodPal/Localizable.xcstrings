    "Vier Zentiliter Irish Cream ins vorgewärmte Glas, den heissen Kaffee über den Löffelrücken darübergiessen, halbsteifen Rahm obenauf.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Zentiliter Irish Cream ins vorgewärmte Glas, den heissen Kaffee über den Löffelrücken darübergiessen, halbsteifen Rahm obenauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four centilitres of Irish cream into the warmed glass, the hot coffee poured over the back of a spoon, half-whipped cream on top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro centilitros de crema irlandesa en el vaso precalentado, el café caliente vertido sobre el dorso de una cuchara, nata semimontada encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre centilitres de crème irlandaise dans le verre préchauffé, le café chaud versé sur le dos d’une cuillère, crème à demi fouettée dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro centilitri di crema irlandese nel bicchiere preriscaldato, il caffè caldo versato sul dorso di un cucchiaio, panna semimontata sopra."
          }
        }
      }
    },
    "Vietnam. Robusta statt Arabica, Kondensmilch statt frischer: beides kam aus der Not und ist geblieben, weil es zusammenpasst.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietnam. Robusta statt Arabica, Kondensmilch statt frischer: beides kam aus der Not und ist geblieben, weil es zusammenpasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietnam. Robusta instead of arabica, condensed milk instead of fresh: both came out of necessity and stayed because they fit together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietnam. Robusta en vez de arábica, leche condensada en vez de fresca: ambos nacieron de la necesidad y se quedaron porque encajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietnam. Du robusta plutôt que de l’arabica, du lait concentré plutôt que du frais : les deux sont nés de la nécessité et sont restés parce qu’ils s’accordent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietnam. Robusta invece di arabica, latte condensato invece di fresco: entrambi nati dalla necessità e rimasti perché stanno bene insieme."
          }
        }
      }
    },
    "Vorheriger Tag": {
      "extractionState": "manual",
      "localizations": {
