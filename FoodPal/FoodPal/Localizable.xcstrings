    "Nicht Italien: dort bekommt man auf „un latte“ ein Glas Milch. Als Getränk mit Namen entstand er in den USA.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht Italien: dort bekommt man auf „un latte“ ein Glas Milch. Als Getränk mit Namen entstand er in den USA."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Italy: order “un latte” there and you get a glass of milk. As a drink with a name it grew up in the United States."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Italia no: allí «un latte» es un vaso de leche. Como bebida con nombre nació en Estados Unidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas l’Italie : commandez « un latte » là-bas et vous aurez un verre de lait. Comme boisson nommée, il est né aux États-Unis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non l’Italia: lì «un latte» è un bicchiere di latte. Come bevanda con un nome è nato negli Stati Uniti."
          }
        }
      }
    },
