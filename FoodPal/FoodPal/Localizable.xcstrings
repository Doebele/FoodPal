    "Eis ins Glas, Tonic darüber, zuletzt der Espresso über den Löffelrücken. Umgekehrt reisst die Kohlensäure die Schichten sofort auseinander.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eis ins Glas, Tonic darüber, zuletzt der Espresso über den Löffelrücken. Umgekehrt reisst die Kohlensäure die Schichten sofort auseinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice in the glass, tonic over it, the espresso last over the back of a spoon. The other way round, the carbonation tears the layers apart at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hielo en el vaso, tónica encima, el espresso al final sobre el dorso de una cuchara. Al revés, el gas rompe las capas de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De la glace dans le verre, le tonic par-dessus, l’expresso en dernier sur le dos d’une cuillère. Dans l’autre sens, le gaz déchire aussitôt les couches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghiaccio nel bicchiere, tonica sopra, l’espresso per ultimo sul dorso del cucchiaio. Al contrario, l’anidride carbonica strappa subito gli strati."
          }
        }
      }
    },
    "Erfassen": {
      "extractionState": "manual",
