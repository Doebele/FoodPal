    },
    "Vanillesirup, warme Milch, Schaum — und der Espresso zuletzt obendrauf statt zuerst hinein. Darüber ein Gitter aus Karamell.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanillesirup, warme Milch, Schaum — und der Espresso zuletzt obendrauf statt zuerst hinein. Darüber ein Gitter aus Karamell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanilla syrup, warm milk, foam — and the espresso on top at the end instead of into it at the start. A lattice of caramel over that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirope de vainilla, leche caliente, espuma — y el espresso encima al final en lugar de dentro al principio. Encima, una rejilla de caramelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirop de vanille, lait chaud, mousse — et l’expresso posé dessus à la fin au lieu d’être versé dedans au début. Par-dessus, un quadrillage de caramel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sciroppo alla vaniglia, latte caldo, schiuma — e l’espresso sopra alla fine invece che dentro all’inizio. Sopra, una griglia di caramello."
          }
        }
      }
    },
