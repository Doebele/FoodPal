{
  "sourceLanguage": "de",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog nutzt die Kamera, um Mahlzeiten zu fotografieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog uses the camera to photograph meals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog usa la cámara para fotografiar tus comidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog utilise l’appareil photo pour photographier vos repas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog usa la fotocamera per fotografare i pasti."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog liest bestehende Werte aus Health, um doppelte Eintragungen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog reads existing values from Health to avoid duplicate entries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog lee los valores que ya están en Salud para evitar entradas duplicadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog lit les valeurs déjà présentes dans Santé afin d’éviter les doublons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog legge i valori già presenti in Salute per evitare voci doppie."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog schreibt Kalorien, Koffein und Makros in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog writes calories, caffeine and macros to Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog escribe calorías, cafeína y macros en Apple Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog enregistre les calories, la caféine et les macros dans Apple Santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog scrive calorie, caffeina e macro in Apple Salute."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog spricht mit LM Studio auf deinem Mac im lokalen Netz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog talks to LM Studio on your Mac in the local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog se comunica con LM Studio en tu Mac dentro de la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog communique avec LM Studio sur votre Mac dans le réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog comunica con LM Studio sul tuo Mac nella rete locale."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog hört zu, während du eine Mahlzeit diktierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog listens while you dictate a meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog escucha mientras dictas una comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog écoute pendant que vous dictez un repas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog ascolta mentre detti un pasto."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog wandelt das Diktierte in Text um, damit du es vor dem Schätzen noch ändern kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog turns what you dictate into text so you can correct it before the estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog convierte lo dictado en texto para que puedas corregirlo antes de la estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog convertit votre dictée en texte pour que vous puissiez la corriger avant l’estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafcalog converte il dettato in testo, così puoi correggerlo prima della stima."
          }
        }
      }
    }
  },
  "version": "1.0"
}
