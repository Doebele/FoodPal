{
  "sourceLanguage": "de",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal nutzt die Kamera, um Mahlzeiten zu fotografieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal uses the camera to photograph meals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal utilise l’appareil photo pour photographier vos repas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal usa la fotocamera per fotografare i pasti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal usa la cámara para fotografiar tus comidas."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal liest bestehende Werte aus Health, um doppelte Eintragungen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal reads existing values from Health to avoid duplicate entries."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal lit les valeurs déjà présentes dans Santé afin d’éviter les doublons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal legge i valori già presenti in Salute per evitare voci doppie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal lee los valores que ya están en Salud para evitar entradas duplicadas."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal schreibt Kalorien, Koffein und Makros in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal writes calories, caffeine and macros to Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal enregistre les calories, la caféine et les macros dans Apple Santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal scrive calorie, caffeina e macro in Apple Salute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal escribe calorías, cafeína y macros en Apple Salud."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal spricht mit LM Studio auf deinem Mac im lokalen Netz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal talks to LM Studio on your Mac in the local network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal communique avec LM Studio sur votre Mac dans le réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal comunica con LM Studio sul tuo Mac nella rete locale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal se comunica con LM Studio en tu Mac dentro de la red local."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal hört zu, während du eine Mahlzeit diktierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal listens while you dictate a meal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal écoute pendant que vous dictez un repas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal ascolta mentre detti un pasto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal escucha mientras dictas una comida."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal wandelt das Diktierte in Text um, damit du es vor dem Schätzen noch ändern kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal turns what you dictate into text so you can correct it before the estimate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal convertit votre dictée en texte pour que vous puissiez la corriger avant l’estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal converte il dettato in testo, così puoi correggerlo prima della stima."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FoodPal convierte lo dictado en texto para que puedas corregirlo antes de la estimación."
          }
        }
      }
    }
  },
  "version": "1.0"
}
